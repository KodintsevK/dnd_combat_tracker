{
    "compilerOptions": {
      "target": "ES6",
      "lib": ["DOM", "DOM.Iterable", "ES2022"],
      "module": "ESNext",
      "moduleResolution": "node",
      "strict": true,
      "jsx": "react-jsx",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "baseUrl": "src",
      "paths": {
        "@/*": ["./*"]
      },
      "types": ["react", "node"]      
    },
    "include": ["src", "declaration.d.ts"]

}